/target

.env

# Presentaciones: se distribuyen como assets de GitHub Releases, no por git
presentations/

# Metadata del tooling de agentes (hash + fecha; se regenera sola)
.atl/

# Cuerpos capturados por `cargo run --example captura`. Llevan el CLAUDE.md,
# el AGENTS.md y la configuracion de quien los capture: NUNCA se versionan.
/capturas/

# Respaldos que deja `git mergetool` al resolver un conflicto (los deja por
# defecto: `mergetool.keepBackup` viene activado). Son una copia entera del
# fichero, asi que un `git add -A` distraido commitea cientos de KB de codigo
# duplicado y viejo. Ya paso una vez con `src/bin/monitor.rs.orig`, que ademas
# se quedo dias en el arbol y confundio el diagnostico de una rama.
*.orig

# Bytecode de Python del banco de tareas (#29). Se genera al ejecutar el
# verificador in situ y no es fuente: si se rastrea, una ejecucion sucia
# puede alterar la siguiente.
__pycache__/
*.pyc

# Salida de las corridas del corredor del nivel 1 (#121): rastros del harness
# por repeticion. Son basura de ejecucion, no artefactos del proyecto.
rastros-corredor/

# Datos por repeticion que escribe el corredor del nivel 1 (#121/#122). Son
# medidas de una corrida concreta, no artefactos del proyecto: el informe se
# regenera corriendo el corredor otra vez.
datos-corredor.jsonl
